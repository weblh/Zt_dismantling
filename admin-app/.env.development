VITE_PUBLIC_HOST=http://192.168.110.47:5173

# 腾讯云 COS 文件/图片根地址
VITE_COS_BASE_URL=https://hcr-1300429327.cos.ap-beijing.myqcloud.com

# 三套前端互跳地址（开发端口）
